# Google Apps Script Web App deployment URL (server-side only, never exposed to the client)
APPS_SCRIPT_URL=

# Must match the SHARED_SECRET script property set in Apps Script
SHARED_SECRET=

# Canonical origin, used for metadata and Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App Store or TestFlight destination used by shared Roll Call pages
NEXT_PUBLIC_PHASEROLL_DOWNLOAD_URL=

# Better Auth backend
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# PostgreSQL connection (server-side only)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (server-side only)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# PhaseRoll API authentication and account deletion
JWT_AUDIENCE=
PHASEROLL_API_BASE_URL=
PHASEROLL_ACCOUNT_DELETION_SERVICE_TOKEN=
